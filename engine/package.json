    "livekit-server-sdk": "^2.19.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.49.1",
    "re2js": "2.8.8",
    "twilio": "^6.2.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.19.0",
